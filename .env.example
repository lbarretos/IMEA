# Copie para .env e preencha. O .env nunca vai para o Git.

# Conta do portal IMEA (obrigatório)
IMEA_USERNAME=your_email@example.com
IMEA_PASSWORD=your_password

# Onde gravar CSVs e imea.db (opcional; padrão ./datasets).
# O agendamento (scripts/update_daily.sh) exige esta variável e aborta se a pasta não existir.
IMEA_DATASETS_DIR=/caminho/para/datasets

# Pasta para onde copiar a base com leitura liberada a todos os usuários (opcional)
# IMEA_SHARED_DIR=/Users/Shared/imea-research
